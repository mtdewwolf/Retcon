# Normalize line endings: LF in the repository for everything text.
* text=auto eol=lf

# Windows-specific files keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.rc text eol=crlf
*.sln text eol=crlf
*.vcxproj text eol=crlf

# Binary assets.
*.png binary
*.ico binary
*.jpg binary
*.ttf binary
